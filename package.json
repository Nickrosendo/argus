{
  "name": "argus-screen-time",
  "version": "1.0.0",
  "description": "A Chrome and Firefox extension that monitors and visualizes the time you spend on different websites",
  "main": "background.js",
  "scripts": {
    "generate-icons": "node create-icons.js",
    "build": "webpack --config webpack.prod.js",
    "build:dev": "webpack --config webpack.dev.js",
    "build:chrome": "webpack --config webpack.prod.js",
    "build:firefox": "webpack --config webpack.prod.js && node scripts/prepare-firefox.js",
    "watch": "webpack --watch --config webpack.dev.js",
    "dev": "npm run build:dev && node dev.js",
    "dev:chrome": "npm run build:dev && node dev.js --chrome",
    "dev:firefox": "npm run build:dev && node dev.js --firefox",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "chrome-extension",
    "firefox-addon",
    "screen-time",
    "productivity",
    "time-tracker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@types/jest": "^29.5.12",
    "archiver": "^5.3.2",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.0.0",
    "canvas": "^2.11.2",
    "chokidar": "^3.6.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  }
}
