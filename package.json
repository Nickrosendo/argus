{
  "name": "argus-screen-time",
  "version": "1.0.1",
  "description": "A Chrome and Firefox extension that monitors and visualizes the time you spend on different websites",
  "main": "background.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "rollup --config rollup.chrome.js",
    "build:firefox": "rollup --config rollup.firefox.js",
    "build:dev": "npm run build:chrome:dev && npm run build:firefox:dev",
    "build:chrome:dev": "rollup --config rollup.chrome.dev.js",
    "build:firefox:dev": "rollup --config rollup.firefox.dev.js",
    "watch:chrome": "rollup --watch --config rollup.chrome.dev.js",
    "watch:firefox": "rollup --watch --config rollup.firefox.dev.js",
    "package": "node scripts/package.js",
    "package:chrome": "node scripts/package.js --chrome",
    "package:firefox": "node scripts/package.js --firefox",
    "release": "npm run clean && npm run build && npm run package",
    "dev": "npm run watch:chrome & npm run watch:firefox",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "chrome-extension",
    "firefox-addon",
    "screen-time",
    "productivity",
    "time-tracker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.27.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "archiver": "^5.3.2",
    "babel-jest": "^29.7.0",
    "chokidar": "^3.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rimraf": "^5.0.0",
    "rollup": "^2.79.2",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.8.3"
  }
}
