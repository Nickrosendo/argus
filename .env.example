# Environment variables for Argus Chrome Extension
# Copy this file to .env and add your actual client IDs and API URL

# Google OAuth Client ID (required for Chrome Identity API)
# Get this from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Microsoft OAuth Client ID (required for Microsoft authentication)
# Get this from Azure App Registrations
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here

# API Server URL (for connecting to your backend)
# Development: http://localhost:3000
# Production: https://argus-api-wheo4.sevalla.app
API_URL=http://localhost:3000

# Address of the Argus website. The extension's website bridge only runs on,
# and only accepts messages from, this exact origin.
# Development: http://localhost:3001
# Production: https://argustime.com (the default when unset)
WEBSITE_URL=

# Stripe price IDs the popup sells (required). Use the test-mode prices for
# local builds and the live prices for the store build.
# Live: monthly price_1RfF1bAVP3zUPORKIevuYheC, yearly price_1RfFWYAVP3zUPORKOTZUIxVs
# Test: monthly price_1USSjaAVP3zUPORKGvP9sTbF, yearly price_1USSjbAVP3zUPORKIsfAo27z
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
